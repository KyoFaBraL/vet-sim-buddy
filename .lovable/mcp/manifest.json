          "properties": {
            "status": {
              "type": "string",
              "description": "Filtrar por status: won, lost ou playing."
            },
            "limit": {
              "type": "integer",
              "description": "Número máximo de sessões (padrão 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_session_report",
        "title": "Relatório da simulação",
        "description": "Retorna o relatório de uma sessão de simulação do usuário: dados da sessão, tratamentos aplicados e decisões registradas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
