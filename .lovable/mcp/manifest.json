        "description": "Lista os casos clínicos de desequilíbrio ácido-base disponíveis para o usuário conectado (públicos, próprios e compartilhados).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Filtro opcional por nome do caso."
            },
            "limit": {
              "type": "integer",
              "description": "Número máximo de casos retornados (padrão 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_clinical_case",
        "title": "Detalhar caso clínico",
        "description": "Retorna os detalhes de um caso clínico: descrição, condição primária e valores iniciais dos parâmetros fisiológicos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "case_id": {
              "type": "integer",
              "description": "ID numérico do caso clínico."
            }
          },
          "required": [
            "case_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_treatments",
        "title": "Listar tratamentos",
        "description": "Lista os tratamentos disponíveis no simulador VetBalance, com tipo e descrição.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string",
              "description": "Filtrar por tipo de tratamento."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_sessions",
        "title": "Listar minhas simulações",
        "description": "Lista as sessões de simulação do usuário conectado, com status (won/lost/playing), duração e caso associado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
